    "dist/",
    "i18n/",
    "icon.png",
    "finch.json",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "watch": "tsc -p tsconfig.json --watch",
    "icon": "magick -background none -density 600 assets/typesafe-mark.svg -resize 300x300 -background '#111111' -alpha remove -alpha off -depth 8 -colorspace sRGB PNG24:icon.png",
    "test": "node scripts/smoke.mjs",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@finchtoys/minitool-api": "^0.3.14",
