{
  "name": "finch-jev",
  "version": "0.1.0",
  "description": "Structured evaluation with Jev (TypeSafe AI System One) — via TypeSafe's own API or OpenRouter.",
  "author": {
    "name": "PuterJam"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/finchtoys/finch-releases.git",
    "directory": "extensions/jev"
  },
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "keywords": [
    "finch",
    "mini-tool",
    "typesafe",
    "jev",
    "evaluation",
    "classification",
    "decisions"
