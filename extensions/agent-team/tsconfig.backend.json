{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "declaration": false,
    "outDir": "dist",
    "rootDir": "src",
    "skipLibCheck": true,
    "ignoreDeprecations": "6.0",
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "finch": ["./node_modules/@finchtoys/minitool-api/finch.d.ts"]
    }
  },
  "include": ["src/backend/**/*.ts", "src/backend/**/*.d.ts", "src/shared/**/*.ts"],
  "exclude": ["src/**/*.test.ts"]
}
