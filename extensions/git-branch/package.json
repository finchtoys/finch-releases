{
  "name": "finch-git-branch",
  "version": "0.3.0",
  "description": "Git Branch Manager for Finch Composer toolbar.",
  "author": {
    "name": "Finch Team",
    "url": "https://finchwork.app"
  },
  "homepage": "https://finchwork.app",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/finchtoys/finch-releases.git",
    "directory": "extensions/git-branch"
  },
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json && cp src/scm-panel.html dist/scm-panel.html && cp node_modules/@fontsource/jetbrains-mono/files/jetbrains-mono-latin-400-normal.woff2 dist/jetbrains-mono-latin.woff2 && mkdir -p dist/jetbrains-icons && cp -R src/jetbrains-icons/. dist/jetbrains-icons/"
  },
  "finch": {
    "manifestVersion": 1,
    "id": "git-branch",
    "name": "Git Branch",
    "description": "Switch Git branches from the Composer toolbar with change previews.",
    "systemPrompt": "When creating a Git branch, use create_git_branch. Pass branchName to create and check out a known branch without a form; otherwise omit it to collect the name in a form.",
    "main": "dist/index.js",
    "activationEvents": [
      "onStartup"
    ],
    "extensionType": "official",
    "categories": [
      "developer"
    ],
    "privacyPolicyUrl": "https://finchwork.app/privacy",
    "termsOfServiceUrl": "https://finchwork.app/terms",
    "contributes": {
      "tools": true,
      "composerActions": [
        {
          "id": "git-branch",
          "icon": "git-branch",
          "tooltip": "Git 分支管理"
        }
      ],
      "iconPacks": [
        {
          "id": "git-branch",
          "label": "Git Branch Icons"
        }
      ],
      "appPanel": {
        "title": "Source Control",
        "icon": "ext:git-branch/git-branch",
        "viewType": "finch.git-source-control",
        "instanceMode": "single",
        "showInLauncher": true,
        "source": {
          "type": "local",
          "path": "dist/scm-panel.html"
        },
        "toolbar": [
          {
            "type": "title",
            "id": "scm-title",
            "icon": "ext:git-branch/git-branch",
            "label": "Source Control"
          },
          {
            "type": "spacer"
          },
          {
            "id": "refresh",
            "icon": "ext:git-branch/refresh-cw",
            "tooltip": "Refresh repository status"
          },
          {
            "type": "menu",
            "id": "sync",
            "icon": "ext:git-branch/ellipsis",
            "items": [
              {
                "id": "fetch",
                "label": "Fetch"
              },
              {
                "id": "pull",
                "label": "Pull"
              },
              {
                "id": "push",
                "label": "Push"
              }
            ]
          }
        ]
      },
      "skills": false
    },
    "permissions": {
      "filesystem": "none",
      "network": false,
      "shell": true
    }
  },
  "devDependencies": {
    "@finchtoys/minitool-api": "^0.2.14",
    "@types/node": "^26.1.0",
    "typescript": "^6.0.3"
  },
  "files": [
    "dist/",
    "i18n/",
    "icons/",
    "icon.png",
    "README.md",
    "README.zh-CN.md"
  ],
  "dependencies": {
    "@fontsource/jetbrains-mono": "^5.3.0"
  }
}
